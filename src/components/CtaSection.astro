---
interface Props {
  title?: string;
  subtitle?: string;
  btnLabel?: string;
  btnHref?: string;
}

const {
  title = 'Want to experience the Satori platform?',
  subtitle = 'Receive an in-depth look into how artificial intelligence can revolutionize your medical imaging processes.',
  btnLabel = 'Request Demo',
  btnHref = '/request-demo',
} = Astro.props;
---

<section class="cta-block">
  <div class="container">
    <div class="cta-inner text-center">
      <h2>{title}</h2>
      <p>{subtitle}</p>
      <a href={btnHref} class="btn">{btnLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-block {
    padding: 91px 0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(247,248,249,0) 0%, #f7f8f9 100%);
  }

  .cta-inner { max-width: 800px; margin: 0 auto; }

  .text-center { text-align: center; }

  h2 {
    font-size: 60px;
    font-weight: 700;
    color: #2a3342;
    margin-bottom: 20px;
    line-height: 1;
  }

  p {
    font-size: 20px;
    color: #556987;
    margin-bottom: 30px;
  }

  @media (max-width: 992px) { h2 { font-size: 48px; } }
  @media (max-width: 710px) { h2 { font-size: 36px; } p { font-size: 18px; } }
</style>
