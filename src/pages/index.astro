---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

const stats = [
  { number: '7 Years', label: 'Algorithm age', desc: 'The age of the average algorithm currently used in those hospitals' },
  { number: '400+', label: 'AI companies', desc: 'The AI companies that in 2023 alone are creating thousands of algorithms' },
  { number: '20%', label: 'Hospitals', desc: 'The percentage of hospitals that currently use AI algorithms' },
  { number: 'Limited', label: 'Access to AI', desc: 'The access and ability for hospitals to choose the AI algorithms' },
];

const testimonials = [
  {
    img: 'https://testdynamics.net/wp-content/uploads/2023/01/Suja-Chandrasekaran.png',
    name: 'Suja Chandrasekaran',
    title: 'Global Chief Executive, fortune 1 executive, board member- healthcare.',
    quote: 'In order for AI to scale it must be built with explainability and transparency, fluidly help clinical decision makers in supporting them. TestDynamics is one of a kind platform that offers richness of data enabled intelligence, that is compliance to regulatory requirements.',
  },
  {
    img: 'https://testdynamics.net/wp-content/uploads/2023/01/Tstimonial-Devon-Klein.jpg',
    name: 'Dr. Devon Klein, MD',
    title: 'Chairman of Radiology, Atlantic Health System, NJ',
    quote: 'I have been searching for an integrated solution to provide all our AI needs. TestDynamics provides access to a wide range of AI solutions and vendors through a single platform, reducing demands on institutional resources by eliminating multiple implementations, business agreements, and compliance verifications.',
  },
];
---

<Layout title="AI Healthcare Solutions for Medical Imaging" description="We make AI work for healthcare. Turning clinical information and innovations into practical decision-making assets.">

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="home-header-wrapper padding-section-large">

    <div class="container">
      <div class="row">
        <div class="col">
          <div class="max-width-1040">
            <div class="text-center hero-inner-content">
              <h1 class="sub-title">We make <span class="gradient-text">AI work</span> for healthcare</h1>
              <p class="description">Turning clinical information and innovations into practical decision-making assets</p>
              <div class="button-group is-center">
                <a href="/request-demo" class="btn">Request Demo</a>
                <a href="/platform" class="btn border-btn">Discover Satori</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator over the wave curve -->
    <div class="onclick-down">
      <div class="box">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <div class="header_background-image-wrapper" style="background-image:url(https://testdynamics.net/wp-content/uploads/2024/11/marc-olivier-jodoin-eiMzJl3xj4o-unsplash-scaled.jpg)">
      <div class="image-overlay-layer"></div>
      <img
        src="https://testdynamics.net/wp-content/themes/testdynamics/assets/images/headerbg.png"
        alt=""
        class="header_background-image"
      />
    </div>

  </section>

  <!-- ══════════════════════════════════════
       THE CHALLENGE / STATS
  ══════════════════════════════════════ -->
  <section class="section-current-situation-wrapper padding-section-medium">
    <div class="container">

      <!-- Title + description -->
      <div class="row">
        <div class="col">
          <div class="max-width-768">
            <p class="title-tag bg-txt challenge-tag">
              <span class="gradient-text">THE CHALLENGE</span>
            </p>
            <h2 class="sub-title challenge-title">
              Bringing <span class="gradient-text">AI and healthcare</span> closer together
            </h2>
            <p class="sub-description">
              Healthcare providers see an exponential explosion in the complexity and the number of CT, MRI and X-Ray imaging studies, which creates an ever increasing backlog and pressure on specialist radiologists. Prioritizing the most severe cases, reducing errors and increasing productivity and capacity is an enormous challenge which AI can solve.
            </p>
          </div>
        </div>
      </div>

      <!-- Stats + Image -->
      <div class="row current-wrapper">
        <div class="col">
          <div class="section-current-inner">
            {stats.map(stat => (
              <div class="sesction-current-items">
                <div class="text-center">
                  <h3 class="stat-number">{stat.number}</h3>
                  <p class="stat-label">{stat.label}</p>
                  <span class="count-content">{stat.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="col">
          <div class="section-current-img">
            <img
              src="https://testdynamics.net/wp-content/uploads/2023/10/Man-inspects-AI-healthcare-solutions.png"
              alt="TestDynamics man inspecting AI healthcare solutions"
            />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════
       MEET SATORI
  ══════════════════════════════════════ -->
  <section class="section-meet-satori padding-section-large">

    <div class="container">
      <div class="row satori-row">

        <div class="col satori-col-content">
          <div class="satori-content">
            <p class="title-tag bg-txt satori-tag">MEET SATORI</p>
            <h2 class="sub-title satori-title">
              Meet Satori: <br/>Your <span class="gradient-text-blue">masterkey</span> for the AI world
            </h2>
            <div class="meet-satori-list">
              <ul class="list-items">
                <li>Seamless integration between AI Developers and Healthcare Providers</li>
                <li>A wide range of third party AI algorithms at your command</li>
                <li>A vendor-neutral, <a href="/platform" class="satori-link">AI-powered medical imaging platform</a> designed to streamline automated workflows.</li>
                <li>User experience-driven interface</li>
              </ul>
            </div>
            <div class="satori-cta">
              <a href="/platform" class="btn">Discover Satori</a>
            </div>
          </div>
        </div>

        <div class="col satori-col-img">
          <div class="satori-img-box">
            <img
              src="https://testdynamics.net/wp-content/uploads/2023/07/Satori-from-TestDynamics-1.png"
              alt="Satori AI healthcare solutions"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- Background -->
    <div class="header_background-image-wrapper">
      <div class="image-overlay-layer"></div>
      <img
        src="https://testdynamics.net/wp-content/themes/testdynamics/assets/images/headerbg.png"
        alt=""
        class="header_background-image"
      />
    </div>

    <!-- Top wave -->
    <div class="wave-sectiontop">
      <svg width="1440" height="127" preserveAspectRatio="none" viewBox="0 0 1440 127" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="1440" height="125.908" transform="translate(0 1)" fill="#232934"/>
        <path d="M804.997 44.1468L720 57.7916L682.561 64.8755C469.411 105.206 250.589 105.206 37.4386 64.8755L0 57.7916V0H1440V57.7916L1355 44.1468C1172.83 14.9028 987.166 14.9028 804.997 44.1468Z" fill="#ffffff"/>
      </svg>
    </div>

    <!-- Bottom wave -->
    <div class="wave-section">
      <svg width="1440" height="127" preserveAspectRatio="none" viewBox="0 0 1440 127" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="1440" height="125.908" transform="translate(0 1)" fill="white"/>
        <path d="M804.997 44.1468L720 57.7916L682.561 64.8755C469.411 105.206 250.589 105.206 37.4386 64.8755L0 57.7916V0H1440V57.7916L1355 44.1468C1172.83 14.9028 987.166 14.9028 804.997 44.1468Z" fill="#232934"/>
      </svg>
    </div>

  </section>

  <!-- ══════════════════════════════════════
       TESTIMONIALS
  ══════════════════════════════════════ -->
  <section class="section-testimonial padding-section-small">
    <div class="container">
      <div class="row">
        <div class="col">
          <div class="max-width-944">
            <div class="testimonial-slider" id="testimonial-slider">
              <div class="slider-track-outer">
              <div class="slider-track" id="slider-track">
                {testimonials.map(t => (
                  <div class="testimonial-items">
                    <div class="testimonial-wrapper">
                      <div class="testimonial-inner item1">
                        <div class="testimonial-img-box">
                          <div class="img-box">
                            <img src={t.img} alt={t.name} />
                          </div>
                          <div class="content">
                            <p class="card-small-title">{t.name}</p>
                            <span>{t.title}</span>
                          </div>
                        </div>
                      </div>
                      <div class="testimonial-inner item2">
                        <div class="testi-content-inner">
                          <p class="extra-small-title">{t.quote}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              </div>
              <button class="slick-arrow slick-prev" id="testi-prev" aria-label="Previous">
                <svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.5 1L1.5 8L8.5 15" stroke="#2a3342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="slick-arrow slick-next" id="testi-next" aria-label="Next">
                <svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.5 1L8.5 8L1.5 15" stroke="#2a3342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <ul class="slick-dots" id="slick-dots">
                {testimonials.map((_, i) => (
                  <li class={i === 0 ? 'slick-active' : ''}><button data-index={i}></button></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</Layout>

<style>
  /* ── UTILITY ── */
  .text-center { text-align: center; }
  .is-center { justify-content: center; }
  .max-width-1040 { max-width: 1040px; margin: 0 auto; }
  .max-width-768 { max-width: 768px; }

  /* ── HERO ── */
  .home-header-wrapper {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .home-header-wrapper .container {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  .home-header-wrapper .row {
    display: flex;
  }

  .home-header-wrapper .col {
    width: 100%;
  }

  /* Bottom curve / wave via mask.png */
  .home-header-wrapper::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 168px;
    content: "";
    z-index: 90;
    background-image: url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/mask.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-inner-content {
    padding: 80px 0 180px;
  }

  .home-header-wrapper .sub-title {
    color: #fff;
    font-size: 60px;
    margin-bottom: 25px;
  }

  .home-header-wrapper .description {
    font-size: 20px;
    color: #bbc3cf;
    margin-bottom: 35px;
  }

  .home-header-wrapper .button-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-bottom: 35px;
  }

  /* Hero background layers */
  .header_background-image-wrapper {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    z-index: 0;
    background-image: url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/header-bg2.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .image-overlay-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    z-index: 1;
    background-color: rgba(42, 51, 66, 0.92);
  }

  .header_background-image {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 2;
  }

  /* Scroll indicator — absolutely positioned over the wave */
  .home-header-wrapper .onclick-down {
    position: absolute;
    bottom: 110px;
    left: 50%;
    z-index: 99;
    transform: translate(-50%, 0);
  }

  .onclick-down .box { cursor: pointer; }
  .onclick-down .box span {
    display: block;
    width: 6px; height: 6px;
    border-radius: 50px;
    background-image: linear-gradient(270deg, #9281ff 0%, #fe3e70 52.55%, #ff6142 100%);
    transform: rotate(45deg);
    margin: 5px auto;
    animation: animate 2s infinite;
  }
  .onclick-down .box span:nth-child(2) { animation-delay: -0.2s; }
  .onclick-down .box span:nth-child(3) { animation-delay: -0.4s; }
  .onclick-down .box span:nth-child(4) {
    width: 14px; height: 14px;
    animation-delay: -0.6s;
    border-bottom: 4px solid;
    border-right: 4px solid;
    border-image-slice: 1;
    border-image-source: linear-gradient(270deg, #9281ff 0%, #fe3e70 52.55%, #ff6142 100%);
    background-image: none;
    margin: -7px auto;
  }

  @keyframes animate {
    0%   { transform: translateY(20%) rotate(45deg); opacity: 1; }
    50%  { transform: translateY(0%)  rotate(45deg); opacity: 1; }
    100% { transform: translateY(20%) rotate(45deg); opacity: 1; }
  }

  /* ── THE CHALLENGE ── */
  .challenge-tag {
    background: #eef0f3;
    padding: 4px;
    display: inline-block;
    border-radius: 2px;
    margin-bottom: 20px;
    line-height: 1;
  }

  .challenge-title {
    color: #2a3342;
    margin-bottom: 20px;
  }

  .sub-description {
    font-size: 20px;
    color: #556987;
    margin-bottom: 0;
  }

  .current-wrapper {
    display: flex;
    align-items: center;
    gap: 45px;
    flex-wrap: wrap;
    margin-top: 45px;
  }
  .current-wrapper > .col { width: calc(50% - 23px); }

  .section-current-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 45px 30px;
  }
  .sesction-current-items {
    width: calc(50% - 15px);
    flex-grow: 1;
  }

  .stat-number {
    font-size: 60px;
    font-weight: 700;
    color: #2a3342;
    margin-bottom: 8px;
    line-height: 1;
  }

  .stat-label {
    font-size: 20px;
    font-weight: 700;
    color: #2a3342;
    margin-bottom: 4px;
  }

  .count-content {
    font-size: 16px;
    color: #556987;
    display: block;
  }

  .section-current-img {
    width: 100%;
    padding-left: 30px;
  }
  .section-current-img img {
    border-radius: 6px;
    width: 100%;
    object-fit: cover;
  }

  /* ── MEET SATORI ── */
  .section-meet-satori {
    position: relative;
    overflow: hidden;
    background-color: #232934;
  }

  .section-meet-satori .header_background-image-wrapper {
    z-index: 0;
  }

  .section-meet-satori .container {
    position: relative;
    z-index: 3;
  }

  .satori-tag {
    background: linear-gradient(90deg, #4136f1 -0.68%, #4136f1 -0.67%, #8743ff 100.7%, #8743ff 100.7%);
    padding: 4px;
    line-height: 1;
    border-radius: 2px;
    display: inline-block;
    color: #fff;
    margin-bottom: 20px;
  }

  .satori-title {
    color: #fff;
    margin-bottom: 30px;
    line-height: 1.1;
  }

  .satori-link {
    background: linear-gradient(90deg, #4136f1 -0.68%, #4136f1 -0.67%, #8743ff 100.7%, #8743ff 100.7%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 400;
  }

  .satori-cta {
    margin-top: 40px;
  }

  .satori-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 35px;
  }

  .satori-col-content {
    width: calc(50% - 18px);
  }

  .satori-col-img {
    width: calc(50% - 18px);
  }

  .satori-img-box {
    max-width: 570px;
    margin-left: auto;
  }
  .satori-img-box img {
    width: 100%;
    object-fit: contain;
  }

  /* Top wave */
  .wave-sectiontop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 5;
    line-height: 0;
  }
  .wave-sectiontop svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Bottom wave */
  .wave-section {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 5;
    line-height: 0;
  }
  .wave-section svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── TESTIMONIALS ── */
  .section-testimonial {
    background: radial-gradient(50% 50% at 50% 50%, rgba(247,248,249,0) 0%, #f7f8f9 100%);
  }

  .max-width-944 {
    max-width: 944px;
    margin: 0 auto;
  }

  /* Slider */
  .testimonial-slider {
    position: relative;
  }

  .slider-track-outer {
    overflow: hidden;
  }

  .slider-track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .testimonial-items {
    min-width: 100%;
    flex-shrink: 0;
  }

  .testimonial-wrapper {
    display: grid;
    align-items: center;
    gap: 50px;
    grid-template-columns: 1fr 2fr;
    padding-bottom: 70px;
  }

  /* Arrows */
  .slick-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    border: none;
    cursor: pointer;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.3s;
  }
  .slick-arrow:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.2); }

  .slick-prev { right: calc(100% + 20px); }
  .slick-next { left: calc(100% + 20px); }

  /* Dots */
  .slick-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: flex-end;
    position: absolute;
    bottom: 25px;
    right: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .slick-dots li {
    width: 15px;
    height: 15px;
    background-color: rgba(0,0,0,0.2);
    border-radius: 50%;
    cursor: pointer;
    overflow: hidden;
  }

  .slick-dots li.slick-active { background-color: #2a3342; }

  .slick-dots li button {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0;
  }

  .testimonial-img-box {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .img-box {
    width: 85px;
    height: 85px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  .img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content { width: calc(100% - 115px); }

  .card-small-title {
    font-size: 24px;
    color: #2a3342;
    font-weight: 700;
    margin-bottom: 0;
  }

  .content > span {
    font-size: 18px;
    color: #556987;
    display: block;
    padding-top: 8px;
  }

  .extra-small-title {
    font-size: 24px;
    color: #2a3342;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0;
  }

  .testi-content-inner {
    padding: 26px 50px 10px 60px;
    position: relative;
  }
  .testi-content-inner::before {
    position: absolute; top: 0; left: 0; bottom: 0; right: 0;
    content: "";
    background-image: url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/topquit.png');
    background-position: top left;
    background-repeat: no-repeat;
  }
  .testi-content-inner::after {
    position: absolute; top: 0; left: 0; bottom: 0; right: 0;
    content: "";
    background-image: url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/bottom-quit.png');
    background-position: bottom right;
    background-repeat: no-repeat;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 991px) {
    .current-wrapper { flex-direction: column-reverse; }
    .current-wrapper > .col { width: 100%; }
    .section-current-img { padding-left: 0; max-height: 360px; }
    .satori-col-content, .satori-col-img { width: 100%; }
    .satori-img-box { margin-left: 0; }
    .testimonial-wrapper { grid-template-columns: 1fr; gap: 30px; }
    .testi-content-inner { padding: 50px 35px; }
  }

  @media (max-width: 767px) {
    .home-header-wrapper .sub-title { font-size: 36px; }
    .hero-inner-content { padding: 60px 0 40px; }
    .section-current-inner { gap: 24px 20px; }
    .sesction-current-items { width: calc(50% - 10px); }
  }

  @media (max-width: 1200px) {
    .slick-prev { right: calc(100% + 10px); }
    .slick-next { left: calc(100% + 10px); }
  }

  @media (max-width: 991px) {
    .slick-prev, .slick-next { display: none; }
    .testimonial-wrapper { grid-template-columns: 1fr; gap: 30px; padding-bottom: 60px; }
    .testi-content-inner { padding: 50px 35px; }
    .slick-dots { right: 0; bottom: 15px; }
  }

  @media (max-width: 767px) {
    .hero-inner-content { padding: 60px 0 200px; }
    .section-current-inner { gap: 24px 20px; }
    .sesction-current-items { width: calc(50% - 10px); }
  }

  @media (max-width: 480px) {
    .satori-col-content, .satori-col-img { width: 100%; }
  }
</style>

<script>
  const track = document.getElementById('slider-track') as HTMLElement;
  const dots = document.querySelectorAll('#slick-dots li');
  const slides = document.querySelectorAll('#slider-track .testimonial-items');
  let current = 0;

  function goTo(index: number) {
    current = index;
    track.style.transform = `translateX(-${current * 100}%)`;
    track.style.transition = 'transform 0.5s ease';
    dots.forEach((d, i) => d.classList.toggle('slick-active', i === current));
  }

  document.getElementById('testi-prev')?.addEventListener('click', () => {
    goTo((current - 1 + slides.length) % slides.length);
  });

  document.getElementById('testi-next')?.addEventListener('click', () => {
    goTo((current + 1) % slides.length);
  });

  document.querySelectorAll('#slick-dots li button').forEach((btn, i) => {
    btn.addEventListener('click', () => goTo(i));
  });
</script>
