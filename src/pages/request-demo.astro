---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Request a Demo — Satori Platform" description="Request a demo of the Satori AI medical imaging platform from TestDynamics.">

  <section class="main_hero-form-section">
    <div class="our-form-section">
      <div class="form-box" style="padding-bottom:180px;padding-top:160px;">
        <div class="container" style="padding-left:36px;padding-right:36px;">
          <div class="row" style="display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start;">

            <!-- Left content -->
            <div class="col" style="width:50%;">
              <div class="form-content-inner" style="max-width:500px;">
                <p class="title-tag" style="background:#eef0f3;padding:4px;border-radius:2px;display:inline-block;font-size:12px;margin-bottom:20px;">GET STARTED</p>
                <h1 class="sub-title" style="color:#2a3342;font-size:60px;font-weight:700;line-height:1;margin-bottom:30px;">
                  Experience Satori <span class="gradient-text">in action</span>
                </h1>
                <p style="font-size:20px;color:#556987;margin-bottom:40px;">
                  Receive an in-depth look into how artificial intelligence can revolutionize your medical imaging processes. Our team will walk you through the platform and answer any questions.
                </p>

                <div class="contact_list_section" style="display:grid;grid-template-columns:1fr 1fr;gap:40px;">
                  <div class="contact_list_group">
                    <strong style="display:inline-block;color:#556987;font-size:18px;font-weight:700;margin-bottom:16px;">Platform Benefits</strong>
                    <ul style="padding-left:36px;">
                      {[
                        'See the full range of AI algorithms',
                        'Understand workflow integration',
                        'Compliance & security answers',
                        'Custom implementation options',
                      ].map(item => (
                        <li style="position:relative;color:#556987;font-size:16px;line-height:150%;margin-bottom:16px;padding-left:0;">
                          <span style="position:absolute;left:-36px;top:0;width:24px;height:24px;background-image:url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/Checkbox.svg');background-position:center;background-repeat:no-repeat;background-size:contain;display:inline-block;"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="contact_list_group">
                    <strong style="display:inline-block;color:#556987;font-size:18px;font-weight:700;margin-bottom:16px;">What to Expect</strong>
                    <ul style="padding-left:36px;">
                      {[
                        '30-minute live walkthrough',
                        'Q&A with our team',
                        'No commitment required',
                        'Custom use case discussion',
                      ].map(item => (
                        <li style="position:relative;color:#556987;font-size:16px;line-height:150%;margin-bottom:16px;">
                          <span style="position:absolute;left:-36px;top:0;width:24px;height:24px;background-image:url('https://testdynamics.net/wp-content/themes/testdynamics/assets/images/Checkbox.svg');background-position:center;background-repeat:no-repeat;background-size:contain;display:inline-block;"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: form -->
            <div class="col col-form" style="width:calc(50% - 40px);position:sticky;top:110px;">
              <div class="contact-block-form" style="padding:0 50px 20px;">
                <div class="contact-block-form-inner" style="position:relative;top:-30px;">
                  <div class="contact-block-content text-center" style="text-align:center;margin-bottom:20px;">
                    <div class="message-box" style="background:linear-gradient(270deg,#9281ff 0%,#fe3e70 52.55%,#ff6142 100%);border-radius:12px;width:64px;height:64px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.72 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.63 1.26h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.61-.61a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                      </svg>
                    </div>
                    <h3 style="font-size:24px;font-weight:700;color:#2a3342;margin-bottom:8px;">Request your demo</h3>
                    <p style="font-size:14px;color:#556987;">Fill out the form and we'll be in touch shortly.</p>
                  </div>

                  <form name="demo-request" method="POST" data-netlify="true" style="padding:40px;background:#fff;border-radius:0.5rem;box-shadow:0px 32px 64px -12px rgba(85,105,135,0.08);">
                    <input type="hidden" name="form-name" value="demo-request" />

                    <div class="form-field">
                      <label>Name <span style="color:#ff6142;">*</span></label>
                      <input type="text" name="name" required placeholder="Your full name" />
                    </div>
                    <div class="form-field">
                      <label>Organization <span style="color:#ff6142;">*</span></label>
                      <input type="text" name="organization" required placeholder="Hospital or institution name" />
                    </div>
                    <div class="form-field">
                      <label>Work Email <span style="color:#ff6142;">*</span></label>
                      <input type="email" name="email" required placeholder="you@organization.com" />
                    </div>
                    <div class="form-field">
                      <label>Phone number (optional)</label>
                      <input type="tel" name="phone" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="form-field">
                      <label>Your Role (optional)</label>
                      <input type="text" name="role" placeholder="e.g. Chief Radiologist" />
                    </div>
                    <div class="form-field">
                      <label>Anything you'd like us to know? (optional)</label>
                      <textarea name="message" rows="4" placeholder="Tell us about your current workflow or specific needs..."></textarea>
                    </div>

                    <button type="submit" class="btn" style="width:100%;font-size:18px;line-height:29px;">Request Demo</button>
                    <p style="font-size:14px;color:#556987;text-align:center;margin-top:16px;">We value your privacy. Your details will only be used to arrange your demo.</p>
                  </form>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .main_hero-form-section { background-color: #f7f8f9; }

  .form-field {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    color: #404f65;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
  }
  input, textarea {
    border: 1px solid #d5dae1;
    border-radius: 6px;
    height: 40px;
    width: 100%;
    background: #fff;
    padding: 8px 16px;
    font-size: 16px;
    font-family: 'Manrope', sans-serif;
    color: #2a3342;
    transition: border-color 0.2s;
  }
  input:focus, textarea:focus { outline: none; border-color: #9281ff; }
  textarea { height: 100px; resize: vertical; }
  input::placeholder, textarea::placeholder { color: rgba(0,0,0,0.36); }

  @media (max-width: 1199px) {
    .row { flex-direction: column; }
    .col { width: 100% !important; }
    .col-form { position: relative !important; top: 0 !important; }
    .contact-block-form { padding: 0 20px 20px !important; }
  }
</style>
